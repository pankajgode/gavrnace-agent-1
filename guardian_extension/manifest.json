{
  "manifest_version": 3,
  "name": "Guardian Agent",
  "version": "1.0",
  "description": "Real-time AI agent monitoring",
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5001/*",
    "https://chat.deepseek.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Guardian Agent"
  }
}